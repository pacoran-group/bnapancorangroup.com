# Banyuwangi Nature Adventure — bnapancorangroup.com
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Paksa HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Satukan www ke domain utama
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Gambar di /images/ bisa diganti dengan nama file yang sama,
  # jadi cache browser dibatasi 1 jam agar perubahan cepat terlihat.
  ExpiresByType image/webp "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 hour"
  ExpiresByType image/png "access plus 1 hour"
  # CSS/JS hasil build punya nama ber-hash (folder /_astro/), aman di-cache lama.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
