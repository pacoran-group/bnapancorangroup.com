---
/**
 * Kartu episode Lumi.
 * - Ada link YouTube  → thumbnail + tombol play; pemutar dimuat saat diklik
 *   (youtube-nocookie, tidak memuat skrip YouTube sebelum diputar).
 * - Belum ada link    → kartu "Segera Tayang".
 */
import { youtubeId, type Episode } from '../data/bna';

interface Props {
  episode: Episode;
  featured?: boolean;
}

const { episode, featured = false } = Astro.props;
const id = youtubeId(episode.youtube);
const label = `Lumi ${episode.title}`;
---

<article class:list={['card', featured && 'lg:col-span-2']}>
  {id ? (
    <button
      type="button"
      class="yt-lite group relative block w-full aspect-video bg-black overflow-hidden"
      data-yt-id={id}
      data-yt-title={label}
      aria-label={`Putar ${label}`}
    >
      <img
        src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
        alt=""
        class="w-full h-full object-cover opacity-90"
        loading="lazy"
        width="480"
        height="360"
      />
      <span class="absolute inset-0 grid place-items-center">
        <span class="w-16 h-16 rounded-full grid place-items-center bg-white/90 text-night shadow-[0_0_30px_rgb(103_232_249/0.6)] transition-transform group-hover:scale-110">
          <svg class="w-7 h-7 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </span>
      </span>
    </button>
  ) : (
    <div class="relative aspect-video grid place-items-center overflow-hidden bg-gradient-to-br from-night-2 via-[#141a44] to-[#2a1747]">
      <span class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-glow/20 blur-3xl"></span>
      <span class="absolute -bottom-12 -left-8 w-40 h-40 rounded-full bg-violet/20 blur-3xl"></span>
      <div class="relative text-center">
        <p class="text-5xl font-extrabold glow-text">{String(episode.no).padStart(2, '0')}</p>
        <p class="mt-2 text-[11px] uppercase tracking-[0.25em] text-white/60">Segera Tayang</p>
      </div>
    </div>
  )}
  <div class="p-5">
    <p class="text-[11px] uppercase tracking-[0.2em] text-glow/80">Episode {episode.no}</p>
    <h3 class="mt-1 text-lg">{episode.title}</h3>
    {episode.synopsis && <p class="mt-2 text-sm text-white/70">{episode.synopsis}</p>}
    {id && (
      <a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-xs text-white/50 hover:text-glow">
        Tonton di YouTube ↗
      </a>
    )}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-lite').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = btn.dataset.ytTitle ?? 'Video YouTube';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full';
      const wrap = document.createElement('div');
      wrap.className = 'relative w-full aspect-video bg-black';
      wrap.append(iframe);
      btn.replaceWith(wrap);
      (window as any).gtag?.('event', 'lumi_play', { video_id: btn.dataset.ytId });
    }, { once: true });
  });
</script>
