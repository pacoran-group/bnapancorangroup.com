---
import '../styles/global.css';
import { site, waLinks } from '../data/bna';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object | object[];
}

const {
  title = `${site.name} | ${site.tagline}`,
  description = site.description,
  image = '/images/hero.webp',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { name: 'Wahana', href: '/#zona' },
  { name: 'Peta', href: '/#peta' },
  { name: 'Event & Venue', href: '/event' },
  { name: 'Kemitraan', href: '/kemitraan' },
  { name: 'Info', href: '/#info' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#060918" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Google Analytics 4 (properti Pancoran Group) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MJ5ENQJ1DD" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MJ5ENQJ1DD');
    </script>
  </head>
  <body>
    <a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] btn-primary">Langsung ke konten</a>

    <!-- ============ HEADER ============ -->
    <header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-500">
      <div class="container-main flex items-center justify-between h-20">
        <a href="/" class="flex items-center gap-3 text-white" aria-label={`${site.name}, beranda`}>
          <span class="w-10 h-10 rounded-full grid place-items-center font-extrabold text-night text-sm bg-gradient-to-br from-glow to-violet shadow-[0_0_20px_rgb(103_232_249/0.5)]">BNA</span>
          <span class="hidden sm:flex flex-col leading-tight">
            <span class="text-sm font-bold">Banyuwangi Nature Adventure</span>
            <span class="text-[10px] uppercase tracking-[0.2em] text-white/60">by Pancoran Group</span>
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-8" aria-label="Navigasi utama">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'text-[12px] uppercase tracking-[0.16em] font-semibold transition-colors hover:text-glow',
                path === n.href ? 'text-glow' : 'text-white/85',
              ]}
            >
              {n.name}
            </a>
          ))}
          <a href={waLinks.info} target="_blank" rel="noopener noreferrer" data-wa="header" class="btn-primary !py-3 !px-5">Hubungi Kami</a>
        </nav>

        <button
          id="menu-toggle"
          type="button"
          class="lg:hidden w-11 h-11 grid place-items-center rounded-full border border-white/20 text-white"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Buka menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>

      <div id="mobile-menu" class="lg:hidden hidden border-t border-white/10 bg-night/95 backdrop-blur-lg">
        <nav class="container-main flex flex-col py-6 gap-1" aria-label="Navigasi mobile">
          {nav.map((n) => (
            <a href={n.href} class="py-3 text-base font-semibold text-white/90 hover:text-glow border-b border-white/5">{n.name}</a>
          ))}
          <a href={waLinks.info} target="_blank" rel="noopener noreferrer" data-wa="menu-mobile" class="btn-primary mt-4">Hubungi via WhatsApp</a>
        </nav>
      </div>
    </header>

    <main id="konten">
      <slot />
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="border-t border-white/10 bg-night-2">
      <div class="container-main py-16 grid gap-12 md:grid-cols-4">
        <div class="md:col-span-2">
          <p class="text-xl font-bold text-white">{site.name}</p>
          <p class="mt-2 text-white/60 max-w-md">{site.tagline}. Hybrid Eco-Lifestyle Park di {site.location}.</p>
          <a href={site.parent.url} class="inline-flex items-center gap-3 mt-6 opacity-80 hover:opacity-100 transition-opacity">
            <span class="text-xs uppercase tracking-[0.2em] text-white/60">Bagian dari</span>
            <img src="/images/logo-pancoran-group-white.webp" alt="Pancoran Group" class="h-9 w-auto" loading="lazy" />
          </a>
        </div>
        <div>
          <p class="eyebrow">Jelajahi</p>
          <ul class="mt-4 grid gap-2 text-sm">
            {nav.map((n) => <li><a href={n.href} class="text-white/70 hover:text-glow">{n.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Kontak</p>
          <ul class="mt-4 grid gap-2 text-sm text-white/70">
            <li><a href={waLinks.info} target="_blank" rel="noopener noreferrer" data-wa="footer" class="hover:text-glow">WhatsApp {site.whatsappDisplay}</a></li>
            <li><a href={`mailto:${site.email}`} class="hover:text-glow">{site.email}</a></li>
            <li><a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-glow">{site.location}</a></li>
          </ul>
        </div>
      </div>
      <div class="container-main py-6 border-t border-white/5 flex flex-col md:flex-row justify-between gap-2 text-xs text-white/40">
        <p>© {new Date().getFullYear()} {site.name} · {site.parent.name}</p>
        <p>Gambar pada situs ini merupakan ilustrasi konsep dan dapat berbeda dengan kondisi sebenarnya.</p>
      </div>
    </footer>

    <!-- Tombol WhatsApp melayang -->
    <a
      href={waLinks.info}
      target="_blank"
      rel="noopener noreferrer"
      data-wa="floating"
      class="fixed bottom-5 right-5 z-40 w-14 h-14 rounded-full grid place-items-center bg-[#25D366] text-white shadow-lg shadow-black/40 hover:scale-110 transition-transform"
      aria-label="Chat WhatsApp Banyuwangi Nature Adventure"
    >
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.612.616l4.573-1.46A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.239 0-4.308-.724-5.992-1.95l-.418-.312-2.715.867.887-2.642-.342-.443A9.935 9.935 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
    </a>

    <script>
      // Header berubah solid saat di-scroll
      const header = document.getElementById('site-header')!;
      const onScroll = () => {
        const solid = window.scrollY > 40;
        header.classList.toggle('bg-night/90', solid);
        header.classList.toggle('backdrop-blur-lg', solid);
        header.classList.toggle('shadow-lg', solid);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Menu mobile
      const toggle = document.getElementById('menu-toggle')!;
      const menu = document.getElementById('mobile-menu')!;
      const setMenu = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
        if (open) header.classList.add('bg-night/90');
      };
      toggle.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // Animasi muncul saat di-scroll
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('visible')),
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // GA4: catat setiap klik tombol WhatsApp
      document.querySelectorAll<HTMLAnchorElement>('[data-wa]').forEach((a) =>
        a.addEventListener('click', () =>
          (window as any).gtag?.('event', 'whatsapp_click', { brand: 'bna', placement: a.dataset.wa })
        )
      );
    </script>
  </body>
</html>
