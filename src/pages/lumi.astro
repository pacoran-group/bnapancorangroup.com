---
import Layout from '../layouts/Layout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { site, lumi, lumiEpisodes, releasedEpisodes, img } from '../data/bna';

const released = releasedEpisodes();
const total = lumiEpisodes.length;
const latest = released.at(-1);
const upcoming = lumiEpisodes.find((e) => !released.includes(e));
const followUrl = lumi.playlistUrl || lumi.channelUrl;
---

<Layout
  title={`Serial ${lumi.name}: Film Pendek ${total} Episode | Banyuwangi Nature Adventure`}
  description={`${lumi.intro} Tonton semua episodenya di sini.`}
  image="/images/lumi.webp"
>
  <!-- HERO -->
  <section class="relative min-h-[65svh] flex items-end overflow-hidden">
    <div class="absolute inset-0 lg:left-[38%]">
      <img src={img('lumi')} alt={`${lumi.name}, maskot Banyuwangi Nature Adventure`} class="w-full h-full object-cover object-[50%_30%]" loading="eager" fetchpriority="high" width="1376" height="768" />
      <div class="absolute inset-0 bg-gradient-to-t from-night via-night/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-night/80 via-night/20 to-transparent lg:from-night lg:via-night/10"></div>
    </div>
    <div class="relative container-main w-full pb-16 pt-36">
      <span class="chip">Serial YouTube · {total} Episode</span>
      <h1 class="mt-6 text-5xl md:text-7xl font-extrabold">Serial <span class="glow-text">{lumi.name}</span></h1>
      <p class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl">{lumi.intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <p class="text-white/70">
          <span class="text-2xl font-bold text-white">{released.length}</span> / {total} episode sudah tayang
        </p>
        {followUrl && (
          <a href={followUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Ikuti di YouTube</a>
        )}
      </div>
    </div>
  </section>

  <!-- EPISODE TERBARU -->
  {latest && (
    <section class="section-padding pb-0">
      <div class="container-main">
        <span class="eyebrow">Episode terbaru</span>
        <div class="mt-6 grid lg:grid-cols-3 gap-6">
          <EpisodeCard episode={latest} featured />
          {upcoming && (
            <div class="flex flex-col gap-3">
              <span class="eyebrow">Berikutnya</span>
              <EpisodeCard episode={upcoming} />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- SEMUA EPISODE -->
  <section class="section-padding">
    <div class="container-main">
      <h2 class="text-3xl md:text-4xl">Semua episode</h2>
      <p class="mt-3 text-white/60">Episode baru ditambahkan di sini begitu tayang di YouTube.</p>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {lumiEpisodes.map((ep) => <EpisodeCard episode={ep} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-night-2 border-t border-white/10">
    <div class="container-main max-w-3xl text-center">
      <h2 class="text-3xl md:text-5xl">Temui {lumi.name} di <span class="glow-text">{site.shortName}</span></h2>
      <p class="mt-6 text-white/75">Ajak si kecil menjelajahi dunia {lumi.name} secara langsung di Banyuwangi Nature Adventure, Genteng.</p>
      <a href="/#zona" class="btn-ghost mt-10">Lihat Zona & Wahana</a>
    </div>
  </section>
</Layout>
